    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Heap Used %",
      "datasource": {
        "type": "prometheus",
        "uid": "bfroe09bnha0wd"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bfroe09bnha0wd"
          },
          "expr": "jvm.memory.used{service_name=~\"$service\", jvm_memory_type=\"heap\", jvm_memory_pool_name=\"Tenured Gen\"} / jvm.memory.limit{service_name=~\"$service\", jvm_memory_type=\"heap\", jvm_memory_pool_name=\"Tenured Gen\"} * 100",
          "legendFormat": "{{service_name}} Tenured Gen %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "unit": "percent",
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 3,
            "fillOpacity": 25,
            "spanNulls": 300000,
            "showPoints": "auto",
            "pointSize": 5,
            "gradientMode": "none",
            "min": 0,
            "max": 100
          },
          "thresholds": {
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }

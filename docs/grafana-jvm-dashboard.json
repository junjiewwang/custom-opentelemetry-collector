      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "unit": "bytes",
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 3,
            "fillOpacity": 25,
            "spanNulls": 300000,
            "showPoints": "auto",
            "pointSize": 5,
            "gradientMode": "none"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/committed/"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,

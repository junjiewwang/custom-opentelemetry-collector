{
  "title": "JVM Runtime Dashboard",
  "uid": "jvm-runtime",
  "tags": [
    "jvm",
    "otel"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "bfroe09bnha0wd"
        },
        "query": {
          "query": "label_values(jvm.memory.used, service_name)",
          "refId": "service"
        },
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Memory",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Heap - Used vs Committed",
      "datasource": {
        "type": "prometheus",
        "uid": "bfroe09bnha0wd"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bfroe09bnha0wd"
          },
          "expr": "jvm.memory.used{service_name=~\"$service\", jvm_memory_type=\"heap\"}",
          "legendFormat": "{{service_name}} used - {{jvm_memory_pool_name}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bfroe09bnha0wd"
          },
          "expr": "jvm.memory.committed{service_name=~\"$service\", jvm_memory_type=\"heap\"}",
          "legendFormat": "{{service_name}} committed - {{jvm_memory_pool_name}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "unit": "bytes",
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 3,
            "fillOpacity": 25,
            "spanNulls": 300000,
            "showPoints": "auto",
            "pointSize": 5,
            "gradientMode": "none"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/committed/"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    5
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Non-Heap - Used vs Committed",
